# Copy to .env.local and fill in. The app runs without these -- batch runs
# simply are not saved and no history appears on page load.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Preferred: the service-role key. All database access is server-side, and this
# key is never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Alternative to the service-role key: the anon key. Works only once the RLS
# policies in supabase/schema.sql have been applied.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
